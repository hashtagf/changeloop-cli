{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-foundation.dev/schemas/host-instruction-v1.json",
  "title": "Foundation Host Instruction Response",
  "oneOf": [
    { "$ref": "#/$defs/instruction" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "instruction": {
      "type": "object",
      "required": ["protocol", "command", "description", "instruction", "argumentMode", "foundationVersion"],
      "properties": {
        "protocol": { "const": 1 },
        "command": { "enum": ["investigate", "change", "build", "prove", "land", "changes", "feature", "dev"] },
        "description": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "argumentMode": { "enum": ["required", "none"] },
        "foundationVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["protocol", "error"],
      "properties": {
        "protocol": { "const": 1 },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
