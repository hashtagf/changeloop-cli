{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-foundation.dev/schemas/host-agent-contract-v1.json",
  "title": "Foundation Host Agent Contract Response",
  "oneOf": [
    { "$ref": "#/$defs/contract" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "contract": {
      "type": "object",
      "required": ["protocol", "contract", "foundationVersion"],
      "properties": {
        "protocol": { "const": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "foundationVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["protocol", "error"],
      "properties": {
        "protocol": { "const": 1 },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
