{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundation-automated-mutation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "repository", "repositoryCommit", "workspaceDigest", "language", "tool", "mutants"],
  "properties": {
    "protocol": { "const": "foundation-automated-mutation-v1" },
    "repository": { "type": "string", "minLength": 1 },
    "repositoryCommit": { "type": ["string", "null"] },
    "workspaceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "language": { "type": "string", "minLength": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapterVersion", "configDigest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "configDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "line", "operator", "status", "killedBy", "changedSurface"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "operator": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["killed", "survived", "no-coverage", "timeout", "compile-error", "runtime-error", "ignored-equivalent", "unavailable"]
          },
          "killedBy": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "changedSurface": { "enum": ["changed-relevant", "dependency-relevant", "legacy-unrelated", "semantic-required", "unknown"] },
          "durationMs": { "type": "number", "minimum": 0 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
