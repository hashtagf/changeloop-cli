{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundation-crap-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "repository", "repositoryCommit", "workspaceDigest", "language", "tool", "functions"],
  "properties": {
    "protocol": { "const": "foundation-crap-v1" },
    "repository": { "type": "string", "minLength": 1 },
    "repositoryCommit": { "type": ["string", "null"] },
    "workspaceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "language": { "type": "string", "minLength": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapterVersion", "configDigest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "configDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "line", "endLine", "complexity", "coverageKind", "coveragePercent", "crap", "mapping"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "complexity": { "type": "number", "minimum": 1 },
          "coverageKind": { "enum": ["branch", "function", "statement", "unavailable"] },
          "coverageClass": { "enum": ["unit", "integration", "critical-journey"] },
          "coveragePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "crap": { "type": ["number", "null"], "minimum": 1 },
          "mapping": { "enum": ["exact", "range", "function-fallback", "synthetic-zero", "unmapped"] }
        }
      }
    }
  }
}
