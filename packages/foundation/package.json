{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/foundation",
  "version": "2.2.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./bundle": "./src/foundation-bundle.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "foundation:sync": "bun run script/sync-foundation.ts",
    "foundation:verify": "bun run script/verify-foundation.ts"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:"
  }
}
