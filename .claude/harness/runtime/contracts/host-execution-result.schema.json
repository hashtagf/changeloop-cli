{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-foundation.dev/schemas/host-execution-result-v1.json",
  "title": "Foundation Agent Host Execution Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "dispatchId",
    "attempts",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dispatchId": {
      "type": "string",
      "minLength": 1
    },
    "changeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestedModel": {
      "type": [
        "string",
        "null"
      ]
    },
    "actualModel": {
      "type": [
        "string",
        "null"
      ]
    },
    "instructionManifestDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "durationMs": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attempt",
          "status"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "timeout",
              "cancelled",
              "error"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "durationMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fallbackReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "failureClass": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "$ref": "#/$defs/usage"
          }
        }
      }
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "tools": {
      "type": "object",
      "properties": {
        "calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failures": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "timeout",
            "cancelled",
            "error"
          ]
        },
        "failureClass": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "importedAt": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO timestamp the harness recorded when it imported this result. Written by the runtime, not the host."
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cacheTokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
